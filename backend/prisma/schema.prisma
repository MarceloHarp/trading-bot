// Trading Bot - Prisma Schema
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Candle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  openTime  BigInt
  closeTime BigInt
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime])
}

model Signal {
  id              String   @id @default(cuid())
  symbol          String
  timeframe       String
  direction       String   // BUY | SELL
  strategy        String   // SmartMoney | VWAPMomentum | Confluence
  entryPrice      Float
  stopLoss        Float
  targetPrice     Float
  confidence      Float    // 0-1
  reason          String
  meta            String?  // metadata específica de la estrategia (JSON serializado)
  validatedByAI   Boolean  @default(false)
  aiVerdict       String?  // approved | rejected | skipped
  aiComment       String?
  status          String   @default("new") // new | executed | rejected | expired
  createdAt       DateTime @default(now())

  trades          Trade[]

  @@index([symbol, timeframe, createdAt])
  @@index([strategy, createdAt])
}

model Trade {
  id          String    @id @default(cuid())
  signalId    String?
  signal      Signal?   @relation(fields: [signalId], references: [id])
  symbol      String
  direction   String    // BUY | SELL
  entryPrice  Float
  exitPrice   Float?
  quantity    Float
  stopLoss    Float
  targetPrice Float
  pnl         Float?
  pnlPercent  Float?
  status      String    @default("open") // open | closed | cancelled
  closedReason String?  // target | stop | manual | timeout
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  @@index([symbol, status])
  @@index([openedAt])
}

model EngineLog {
  id        String   @id @default(cuid())
  level     String   // info | warn | error
  message   String
  context   String?  // JSON serializado
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ClaudeUsage {
  id           String   @id @default("singleton")
  totalCalls   Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalCostUsd Float    @default(0)
  updatedAt    DateTime @updatedAt
}
