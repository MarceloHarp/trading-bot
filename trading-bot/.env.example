DATABASE_URL="file:./dev.db"

BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key
BINANCE_TESTNET_API_SECRET=your_binance_testnet_api_secret
BINANCE_REST_URL=https://testnet.binance.vision
BINANCE_WS_URL=wss://stream.testnet.binance.vision

CLAUDE_API_KEY=sk-ant-your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

TRADING_SYMBOLS=BTCUSDT,ETHUSDT
TRADING_TIMEFRAMES=1h,4h
ENGINE_INTERVAL_MS=15000
RISK_PER_TRADE_USDT=100
AUTO_EXECUTE=false
CLAUDE_VALIDATION=false

# Rate limiting de signals (0 = sin limite)
MAX_SIGNALS_PER_HOUR=3
MAX_SIGNALS_PER_DAY=10

# Alertas por email (Gmail)
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=tu_email@gmail.com
ALERT_SMTP_PASS=xxxx_xxxx_xxxx_xxxx
ALERT_EMAIL_TO=tu_email@gmail.com

# Alertas Telegram (llega al celu, gratis)
# 1. Habla con @BotFather en Telegram -> /newbot -> copia el token
# 2. Habla con tu bot, entra a: https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Copia el "id" que aparece en "chat"
ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_TOKEN=123456789:ABCdef...
ALERT_TELEGRAM_CHAT_ID=987654321
