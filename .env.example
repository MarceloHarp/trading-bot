# ============================================================
# TRADING BOT — VARIABLES DE ENTORNO
# ============================================================
# IMPORTANTE: Copiar este archivo a .env y completar con tus valores
# NUNCA subir .env a GitHub (usar .env.example solamente)

# ============================================================
# BASE DE DATOS
# ============================================================
DATABASE_URL="file:./dev.db"

# ============================================================
# BINANCE SPOT TESTNET
# ============================================================
# Obtener en: https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=tu_api_key_aqui
BINANCE_TESTNET_API_SECRET=tu_api_secret_aqui
BINANCE_REST_URL=https://testnet.binance.vision
BINANCE_WS_URL=wss://stream.testnet.binance.vision

# ============================================================
# BINANCE FUTURES TESTNET (Opcional)
# ============================================================
# Obtener en: https://testnet.binancefuture.com
FUTURES_TESTNET_API_KEY=
FUTURES_TESTNET_API_SECRET=
FUTURES_REST_URL=https://testnet.binancefuture.com
FUTURES_LEVERAGE=5
FUTURES_MARGIN_TYPE=ISOLATED

# ============================================================
# MODO DE TRADING
# ============================================================
# Valores: spot | futures
TRADING_MODE=spot

# Pares a tradear (separados por coma)
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,ADAUSDT,SOLUSDT,BNBUSDT

# Timeframes activos (separados por coma)
# Valores válidos: 1m, 5m, 15m, 1h, 4h, 1d
# RECOMENDACIÓN: 1h,4h (1m eliminado por ser catastrófico)
TRADING_TIMEFRAMES=1h,4h

# ============================================================
# PARÁMETROS DE RIESGO
# ============================================================
# Máximo de trades abiertos simultáneamente
MAX_OPEN_TRADES=5

# Máximo de signals por día (DB-persistent)
MAX_SIGNALS_PER_DAY=20

# Riesgo por trade en USDT (1% recomendado = 100 USDT con capital 10k)
RISK_PER_TRADE_USDT=100

# Ejecutar órdenes en Binance o solo paper trading
AUTO_EXECUTE=true

# Intervalo del motor de estrategia (ms)
ENGINE_INTERVAL_MS=15000

# ============================================================
# ENTORNO
# ============================================================
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ============================================================
# ALERTAS POR EMAIL
# ============================================================
ALERT_EMAIL_ENABLED=true

# SMTP configuración (recomendado: Gmail)
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=tu_email@gmail.com
# Contraseña de aplicación (NO tu contraseña de Gmail)
# Generar en: https://myaccount.google.com/apppasswords
# Requiere 2FA habilitado en tu cuenta Google
ALERT_SMTP_PASS=xxxxxxxxxxxxxxxx

# Email donde recibir alertas
ALERT_EMAIL_TO=tu_email@gmail.com

# ============================================================
# ALERTAS TELEGRAM (Opcional)
# ============================================================
ALERT_TELEGRAM_ENABLED=false
# Token del bot de Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID donde enviar mensajes
TELEGRAM_CHAT_ID=

# ============================================================
# CLAUDE API (Opcional)
# ============================================================
# Obtener en: https://console.anthropic.com
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Activar validación de signals con IA
CLAUDE_VALIDATION=false

# ============================================================
# DESARROLLO
# ============================================================
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Habilitar modo de depuración
DEBUG=false
