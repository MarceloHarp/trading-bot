# =========================
# DATABASE
# =========================
DATABASE_URL="postgresql://postgres:trading123@localhost:5432/trading_bot"

# =========================
# BINANCE TESTNET
# =========================
# Crear en https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key
BINANCE_TESTNET_API_SECRET=your_binance_testnet_api_secret
BINANCE_REST_URL=https://testnet.binance.vision
BINANCE_WS_URL=wss://stream.testnet.binance.vision

# =========================
# CLAUDE API
# =========================
# Crear en https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your_key_here
CLAUDE_MODEL=claude-opus-4-5

# =========================
# SERVER
# =========================
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# =========================
# BOT CONFIG
# =========================
# Símbolos a operar (separados por coma)
TRADING_SYMBOLS=BTCUSDT,ETHUSDT
# Timeframes que evalúa el engine
TRADING_TIMEFRAMES=1h,4h
# Intervalo de evaluación del engine (ms)
ENGINE_INTERVAL_MS=15000
# Capital simulado por trade en USDT
RISK_PER_TRADE_USDT=100
# Activar / desactivar ejecución automática (modo paper si false)
AUTO_EXECUTE=true
# Validar con Claude antes de ejecutar (true/false)
CLAUDE_VALIDATION=true
